# ============================================
# LLM 配置（通用格式，必填）
# ============================================
# LLM 提供商（影响 thinking 配置格式和响应解析）
# 支持: deepseek, glm, zhipu, dashscope, qwen, google, gemini, gemma, minimax, fkpai, vllm, custom
# fkpai/vllm: vLLM 部署的 DeepSeek，thinking 用 chat_template_kwargs，reasoning 字段名不同
LLM_PROVIDER=custom
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.xxx.com/v1
LLM_MODEL=your-model-id

# 是否启用推理模式（thinking/reasoning），默认关闭
# 支持: true / false
#LLM_ENABLE_THINKING=false

# 推理强度控制（仅 DeepSeek/GLM/Zhipu 且 thinking=enabled 时生效）
# 支持: low, medium, high, max, xhigh（low/medium 映射为 high，xhigh 映射为 max）
# 不设置则使用 API 默认值（普通请求 high，Agent 请求 max）
#LLM_REASONING_EFFORT=high

# ============================================
# 场景配置（Scene Configuration）
# ============================================
# 选择部署场景，控制安全策略组合
# 支持: personal（个人，默认）/ enterprise（企业）/ financial（金融）/ dev（开发）
#
# 各场景预设安全策略：
# ┌─────────────────────┬─────────────┬─────────────┬─────────────┬─────────────┐
# │ 配置项               │ personal    │ enterprise  │ financial   │ dev         │
# ├─────────────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
# │ SANDBOX_MODE        │ warn        │ enforce     │ enforce     │ warn        │
# │ EXEC_MODE           │ lenient     │ strict      │ strict      │ lenient     │
# │ ENABLE_AUDIT        │ false       │ true        │ true        │ false       │
# │ NETWORK_MODE        │ blocklist   │ blocklist   │ allowlist   │ blocklist   │
# │ DLP_REDACTION       │ false       │ true        │ true        │ false       │
# │ SKILL_TRUST_MODE    │ warn        │ enforce     │ enforce     │ off         │
# │ DISABLED_TOOLS      │ 无          │ 无          │ exec,http   │ 无          │
# │ AI_DISCLAIMER_MODE  │ off         │ once        │ always      │ off         │
# └─────────────────────┴─────────────┴─────────────┴─────────────┴─────────────┘
#
# 企业/金融场景：.env 需 RSA 签名保护，篡改即退出
# 签名命令: npm run sign-env
#COQI_SCENE=personal

# ============================================
# Matcher LLM 配置（可选）
# 用于技能语义匹配，可用轻量模型降低成本
# 不配置则复用主模型
# ============================================
#MATCHER_LLM_PROVIDER=custom
#MATCHER_LLM_API_KEY=your-api-key-here
#MATCHER_LLM_BASE_URL=https://api.xxx.com/v1
#MATCHER_LLM_MODEL=your-model-id

# Matcher 推理模式开关，独立控制，默认关闭
#MATCHER_LLM_ENABLE_THINKING=false

# Matcher 推理强度控制，独立控制，默认不设置
#MATCHER_LLM_REASONING_EFFORT=

# Matcher 请求超时（毫秒），独立控制，默认 60000
#MATCHER_LLM_REQUEST_TIMEOUT=60000

# Matcher 温度参数，独立控制，默认 0.6
#MATCHER_LLM_TEMPERATURE=0.6

# ============================================
# 可选配置
# ============================================

MAX_ITERATIONS=10

# 请求超时时间（毫秒）
LLM_REQUEST_TIMEOUT=60000
LOG_LEVEL=info

# 语言偏好设置 (Language Preference)
# 支持: zh (中文) / en (英文)
LANG=en

# 是否显示 API 使用统计（tokens、成本、时长）
SHOW_USAGE=false


# 工具使用的LLM模型
TOOL_LLM_API_KEY=sk-a7b19784c0364e1b9a469f060447fd9e
TOOL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TOOL_LLM_MODEL=qwen3.5-35b-a3b

# 邮件 SMTP 配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=your-email@example.com

# ============================================
# Web Server 配置 (Web Server Configuration)
# ============================================

# Web 服务端口，默认 3000
WEB_PORT=3000

# Web 服务监听地址，默认 127.0.0.1（仅本机访问）
# 设置 0.0.0.0 允许外部网络访问（注意安全风险）
#WEB_HOST=127.0.0.1

# API 认证密钥（空值 = 不启用认证）
WEB_API_KEY=

# CORS 允许的来源（默认: localhost:5173,localhost:3000）
#WEB_CORS_ORIGINS=

# ============================================
# 工具禁用配置 (Tool Disable Configuration)
# ============================================
# 可选：启用/禁用工具（逗号分隔要禁用的工具名）
#
# 示例配置 / Example configurations:
# DISABLED_TOOLS=exec,python_ptc
# DISABLED_TOOLS=chrome_nav,chrome_interact,chrome_extract,chrome_env
# DISABLED_TOOLS=send_email,calendar
#
# 不设置或留空 = 加载所有工具
#DISABLED_TOOLS=exec

# ============================================
# 提示词工具精简配置 (Prompt Tool Visibility)
# ============================================
# PROMPT_HIDDEN_TOOLS：从工具列表中隐藏指定工具（逗号分隔），减少 token 消耗
# 注意：仅从提示词的工具列表隐藏，工具本身仍可用（LLM 通过 API tools 参数获取完整定义）
#
# PROMPT_VISIBLE_GUIDELINES：工具使用准则白名单，只有列出的工具才显示准则
# 不配置 = 显示全部有准则的工具
#
# 示例：隐藏低频工具，只显示核心工具的准则
# PROMPT_HIDDEN_TOOLS=clipboard,archive,system_info,python_ptc,open,time
# PROMPT_VISIBLE_GUIDELINES=read,write,exec,web_fetch,http_request
#
#PROMPT_HIDDEN_TOOLS=
#PROMPT_VISIBLE_GUIDELINES=

# ============================================
# 文件系统沙箱配置 (File System Sandbox Configuration)
# ============================================

# 沙箱工作目录（可读可写），多个路径用逗号分隔
# 必须配置此项才能使用文件写入功能
# 示例 / Example: SANDBOX_PATHS=D:\WorkData,D:\Output
#
# 沙箱权限规则 / Sandbox Permission Rules:
# ┌─────────────────────┬─────────────┬────────────────────────────┐
# │ 区域                 │ 权限        │ 说明                        │
# ├─────────────────────┼─────────────┼────────────────────────────┤
# │ skills/ 目录         │ 只读        │ 程序内置，存放技能定义       │
# │ SANDBOX_PATHS       │ 可读可写    │ 用户配置的工作目录           │
# │ src/, plugins/ 等   │ 禁止访问    │ 程序目录，保护代码安全       │
# └─────────────────────┴─────────────┴────────────────────────────┘
SANDBOX_PATHS=

# 沙箱模式：enforce（默认，阻断越界访问）/ warn（仅告警）/ off（关闭）
#SANDBOX_MODE=enforce

# 工作区隔离（默认开启）：文件工具仅能访问 user/output/temp/database/logs 与 skills/，不暴露 src/config/.env
# 设为 false 可恢复「整个项目根目录在沙箱内可读」的旧行为
#SANDBOX_WORKSPACE_ONLY=false

# ============================================
# Agent 行为配置 (Agent Behavior Configuration)
# ============================================

# LLM 温度参数 (0-2)，控制输出创造性，越低越确定
#LLM_TEMPERATURE=0.1

# 消息历史大小限制（字节），默认 80KB
#MAX_MESSAGES_SIZE=300000

# 保留最近对话轮数，默认 15 轮
#KEEP_LAST_EXCHANGES=15

# ============================================
# 上下文总结配置 (Context Summarization)
# ============================================
#USE_LLM_CONTEXT_SUMMARY=true
#CONTEXT_SUMMARY_MAX_LENGTH=400

# ============================================
# 性能优化配置 (Performance Optimization)
# ============================================

# 高性能 JSON 序列化后端（默认使用内置 JSON）
#FAST_JSON=json-pack

# ============================================
# LLM HTTP 连接池配置
# ============================================
#LLM_HTTP_MAX_SOCKETS=10
#LLM_KEEP_ALIVE_TIMEOUT=300000

# ============================================
# Matcher HTTP 连接池配置（可选）
# ============================================
#MATCHER_HTTP_MAX_SOCKETS=5
#MATCHER_LLM_KEEP_ALIVE_TIMEOUT=300000

# ============================================
# 审计审查配置 (Audit Configuration)
# 仅投行等强合规场景启用，默认关闭
# ============================================
# 审计功能开关（不设置或 false = 零开销）
#ENABLE_AUDIT=true

# 审计审查 LLM（不配置则 fallback 到 MATCHER_LLM_*，再 fallback 到主模型）
# 推荐使用低成本轻量模型，判断不需要强推理能力
#AUDIT_LLM_PROVIDER=custom
#AUDIT_LLM_API_KEY=your-api-key-here
#AUDIT_LLM_BASE_URL=https://api.xxx.com/v1
#AUDIT_LLM_MODEL=qwen3.5-35b-a3b

# 审查超时（毫秒），默认 5000，超时 = 阻断
#AUDIT_LLM_REQUEST_TIMEOUT=5000

# 审查温度（默认 0，确定性输出）
#AUDIT_LLM_TEMPERATURE=0

# 审查 LLM HTTP 连接池配置（可选）
#AUDIT_HTTP_MAX_SOCKETS=10
#AUDIT_LLM_KEEP_ALIVE_TIMEOUT=300000

# 审查 LLM 推理模式（用于需要推理能力的模型，默认 false）
#AUDIT_LLM_ENABLE_THINKING=false

# 审查 LLM 推理强度控制，默认不设置
#AUDIT_LLM_REASONING_EFFORT=

# ============================================
# 数据库加密密钥（必填）
# 数据库加密密钥（必填，使用 RSA 公钥加密: node scripts/encrypt-config.js "你的密钥"）
DB_ENCRYPTION_KEY={使用 scripts/encrypt-config.js 加密后填入}

# ============================================
# 调试配置 (Debug Configuration)
# ============================================
#DEBUG=false

# ============================================
# 命令执行安全配置 (Command Execution Security)
# ============================================

# AST 安全规则引擎（Phase 1 语义级审计，与正则并行）
# 控制 AST_SECURITY 环境变量的行为（与正则 blockedPatterns 独立并行）：
#   - enforce（默认）: 命中 AST 规则即阻断
#   - warn:            命中规则打印 WARN 日志但不阻断（排查误报用）
#   - off:             完全跳过 AST 审计（仅正则层生效）
#
# 关闭 AST 层后，正则层（rm -rf /、sudo、mkfs 等基础拦截）仍然生效。
# AST 层只影响语义级检测（标志位别名、内联代码审计、PowerShell 别名等）。
#AST_SECURITY=enforce

#EXEC_MODE=lenient
#EXEC_ALLOWED_COMMANDS=python,node,npm,pip

# ============================================
# DLP 数据脱敏配置 (Data Loss Prevention)
# ============================================
#DLP_REDACTION=true
#DLP_SENSITIVE_PATTERNS=

# ============================================
# 归档安全配置 (Archive Security)
# ============================================
#ARCHIVE_MAX_ENTRIES=10000
#ARCHIVE_MAX_UNCOMPRESSED_SIZE=524288000

# ===== Web Search (plugin: plugins/tools/web-search/) =====

# 秘塔搜索 Metaso（推荐首位，国内中文搜索，质量最高）
# 申请: https://metaso.cn
#METASO_API_KEY=

# 博查 AI Search（备选，国内中文搜索）
# 申请: https://open.bocha.cn 选择「AI 搜索」产品
# 免费额度: 1000次/月
#BOCHA_API_KEY=

# Tavily Search（英文技术文档搜索）
# 申请: https://tavily.com/
# 免费额度: 1000次/月
#TAVILY_API_KEY=

# Brave Search（英文通用搜索）
# 申请: https://brave.com/search/api/
# 免费额度: 2000次/月
#BRAVE_SEARCH_API_KEY=

# SearXNG 自建实例（无限制）
#SEARXNG_URL=

# 后端自动选择优先级: metaso > bocha > tavily > brave > searxng
# 强制指定后端: WEB_SEARCH_BACKEND=metaso


# 后端自动选择优先级: bocha > brave > tavily > searxng > duckduckgo
# DuckDuckGo 无需配置，始终可用

# ===== Vision Model (read 图片分析) =====
# 视觉模型 ID，配置后 read 工具可分析图片内容
#VISION_LLM_MODEL=
#VISION_LLM_API_KEY=
#VISION_LLM_BASE_URL=
#VISION_LLM_TIMEOUT=60000

# ============================================
# 技能 Python venv 配置（实验性）
# ============================================
# 启用后 exec_skill 按三级优先级解析 Python 环境：
#   1. skills/<name>/.venv/ - 手动预构建 venv
#   2. skills/<name>/requirements.txt - 自动创建 venv + pip install
#   3. 回退到系统 Python
# 默认 false，保持老行为
#SKILL_PYTHON_VENV=true
